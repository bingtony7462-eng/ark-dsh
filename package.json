{
  "name": "ark-dsh",
  "version": "0.1.2",
  "type": "module",
  "description": "明日方舟自動遊玩 dsh 隨插即用插件組（v1.1，P0 階段：環境偵測、截圖與狀態落地）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingtony7462-eng/ark-dsh.git"
  },
  "homepage": "https://github.com/bingtony7462-eng/ark-dsh#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "arknights",
    "maa"
  ],
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.0-alpha.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./ark-core": {
      "types": "./lib/types/ark-core/index.d.ts",
      "default": "./lib/ark-core/index.js"
    },
    "./ark-device": {
      "types": "./lib/types/ark-device/index.d.ts",
      "default": "./lib/ark-device/index.js"
    },
    "./ark-maa": {
      "types": "./lib/types/ark-maa/index.d.ts",
      "default": "./lib/ark-maa/index.js"
    },
    "./ark-guard": {
      "types": "./lib/types/ark-guard/index.d.ts",
      "default": "./lib/ark-guard/index.js"
    },
    "./ark-box": {
      "types": "./lib/types/ark-box/index.d.ts",
      "default": "./lib/ark-box/index.js"
    },
    "./ark-guide": {
      "types": "./lib/types/ark-guide/index.d.ts",
      "default": "./lib/ark-guide/index.js"
    },
    "./ark-copilot": {
      "types": "./lib/types/ark-copilot/index.d.ts",
      "default": "./lib/ark-copilot/index.js"
    },
    "./ark-planner": {
      "types": "./lib/types/ark-planner/index.d.ts",
      "default": "./lib/ark-planner/index.js"
    },
    "./ark-strategy": {
      "types": "./lib/types/ark-strategy/index.d.ts",
      "default": "./lib/ark-strategy/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "cordis.example.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "p0": "node --import tsx scripts/p0-acceptance.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1 || ^0.1.0-rc.2 || ^0.1.1-rc.1 || ^0.1.2-alpha.2 || ^0.1.3-alpha.2 || ^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2 || ^0.2.3-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "*",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
